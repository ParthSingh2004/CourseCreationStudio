# CourseCreationStudio Environment Variables
# Copy this file to .env locally or set these in Render Dashboard

# Required: Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=

# Required for AI Avatar Presenter: D-ID Studio API Key (from https://studio.d-id.com/account-settings)
D_ID_API_KEY=

# Allowed CORS Origins for FastAPI backend (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Data root directory (defaults to ~/CourseEngineData on Linux/Mac, D:\CourseEngineData on Windows)
COURSE_ENGINE_DATA_ROOT=/tmp/CourseEngineData

# Optional: PostgreSQL connection string (defaults to SQLite if empty)
DATABASE_URL=

# Optional: Unsplash API Access Key for photo slide images
UNSPLASH_ACCESS_KEY=
